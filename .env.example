# ====================================================================
# ASIF BILLAH'S PORTFOLIO CMS — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local to configure your custom environment
# ====================================================================

# 1. ADMIN DASHBOARD CREDENTIALS (Owner Authentication)
ADMIN_EMAIL=asifbillah.cse@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_SECRET_KEY=admin123

# 2. OPTIONAL: SUPABASE CONFIGURATION (For Cloud PostgreSQL & Storage)
# If left blank or unconfigured, the website automatically operates in
# high-performance persistent local disk mode (/data/portfolio.json and /public/uploads/)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. PUBLIC WEBSITE URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
